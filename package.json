{
  "name": "aetherstudy",
  "version": "1.0.0",
  "description": "AetherStudy — Unified Liquid Glass Web and Desktop Academic Workstation",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/server.js",
    "client": "vite",
    "dev": "concurrently -k \"node server/server.js\" \"vite\"",
    "build": "node scripts/sync-pdf-assets.js && tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "node electron/start-dev.js",
    "electron:build": "npm run build && electron-builder",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "googleapis": "^184.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.469.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.32.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^23.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.aetherstudy.suite",
    "productName": "AetherStudy",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
