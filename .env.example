# AetherStudy Enterprise Security & Environment Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Backend Isolated Secrets (Strictly Server-Side in Vercel - Never exposed to client)
SUPER_ADMIN_EMAIL=admin@example.com
OTP_SECRET=generate-a-cryptographically-random-64-character-hex-secret
RESEND_API_KEY=re_your_resend_api_key_here

# Zero-Cost Hidden GitHub Database Pipeline (Vercel Serverless Backend)
# How to get GH_ACCESS_TOKEN: Go to https://github.com/settings/tokens -> Generate new token (classic) -> select 'repo' scope
GH_ACCESS_TOKEN=ghp_your_personal_access_token_with_repo_scope
GITHUB_REPO=BSFrameWorks5253/AetherStudy

# 100% Free Google Drive Storage Options (Zero GCP Billing Account Required)
# OPTION A: Google Apps Script Web App (RECOMMENDED - 0 Google Cloud setup, 0 GCP billing, 100% free)
# Deploy your free Google Apps Script on script.google.com with DriveApp access and paste URL below:
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-appscript-id/exec
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-appscript-id/exec

# OPTION B: Consumer OAuth Client ID (Free popup authorization)
VITE_GOOGLE_CLIENT_ID=your-consumer-oauth-client-id.apps.googleusercontent.com

# Public Frontend Configurations (Non-sensitive)
VITE_API_BASE_URL=/api
VITE_SERVER_PORT=3001

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# 100% Free Cloudflare D1 (5 GB Edge SQL Database) & Cloudflare R2 (10 GB Zero-Egress PDF Storage)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_API_TOKEN=your_d1_api_token
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=aetherstudy-vault
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

